# St Stephen's — copy to `.env` beside this file.
#
#   cp env.example .env && chmod 600 .env
#
# Generate all four at once:
#   {
#     echo "DB_PASSWORD=$(openssl rand -hex 24)"
#     echo "AUTH_SECRET=$(openssl rand -hex 32)"
#     echo "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=$(openssl rand -base64 32)"
#     echo "ADMIN_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-20)"
#   } >> .env

# PostgreSQL password. Set it BEFORE the first `up`: Postgres bakes it into
# the volume on creation, and changing it later locks the EMS out.
DB_PASSWORD=

# Signs session cookies. Changing it signs everyone out.
AUTH_SECRET=

# Encrypts Server Action payloads. Must stay constant across rebuilds, or a
# form submitted mid-deploy fails with "Failed to find Server Action".
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# The first superadmin password, read only while the User table is empty.
# Sign in, change it under Users, then blank this line and `up -d` again.
ADMIN_PASSWORD=

# The school's own name, contacts and logo are NOT set from here. They live in
# the SchoolSetting row and are edited in the app under Settings → School
# Settings. getSchoolSettings() upserts with an empty update, so the defaults
# in code apply only when that row is first created — an existing install will
# never pick up a rename from a redeploy.
